            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{title}}\",\n  \"description\": \"Отчёт готов\",\n  \"status\": \"done\",\n  \"priority\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "07. Фильтр по статусу",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"код ответа 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"все задачи в статусе done\", function () {",
                  "    pm.response.json().items.forEach(function (t) { pm.expect(t.status).to.eql(\"done\"); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks?status=done",
              "host": [
                "{{baseUrl}}"
